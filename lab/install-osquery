#!/bin/sh
# The course version is pinned for reproducibility, not advertised as the latest.
set -eu
case "$(uname -m)" in
    x86_64)
        lab_arch=x86_64
        lab_sha=0f37a478a1dbda24b67c81551e32d734b392c5a2f5deb156bf1c41ca204cfa67 ;;
    aarch64|arm64)
        lab_arch=aarch64
        lab_sha=9ae763820166f75f19970b5147b1930a308865a923ab127f4b8bbaea7b69962a ;;
    *) echo 'Unsupported architecture' >&2; exit 1 ;;
esac
lab_archive=$(mktemp /tmp/osquery.XXXXXX.tgz)
trap 'rm -f "$lab_archive"' EXIT HUP INT TERM
curl --fail --location --retry 2 \
    "https://github.com/osquery/osquery/releases/download/5.23.1/osquery-5.23.1_1.linux_${lab_arch}.tar.gz" \
    -o "$lab_archive"
printf '%s  %s\n' "$lab_sha" "$lab_archive" | sha256sum -c -
# The archive stores UID/GID 1000, which is the student account in this lab.
tar --no-same-owner -xzf "$lab_archive" -C /
test "$(stat -c %u /opt/osquery/bin/osqueryd)" = 0
osqueryi --version
